# Cloud Build 上傳原始碼時排除（與 .dockerignore 對齊，另排除設計稿）
.gcloudignore
node_modules
packages/*/node_modules
.next
.git
.claude
design
design-brief.md
test-assets
worker/*
!worker/notify.ts
supabase/.temp
.env
.env.*
*.log
*.zip
test-results
playwright-report

# E2E 不進映像（next build 會型別檢查到 e2e 對 worker 的引用）
e2e
playwright*.config.ts
